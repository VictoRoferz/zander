# Zander hub — the ONE file to edit per deployment.
# Copy to ".env" in this folder:  copy .env.example .env   (Windows)
#                                 cp .env.example .env       (Mac/Linux)
# docker compose reads ./.env automatically.

# --- Host names (the usual things to change) -------------------------------
# Host shown in the "Open Label Studio" link. Use "localhost" if you browse on
# this PC; use this PC's LAN IP if you open the dashboard from another machine.
LAPTOP_HOST=localhost
# Where the dashboard container reaches the native camerapi on this PC.
# The default (host.docker.internal) is right for Docker Desktop — only
# override for unusual setups.
#CAMERAPI_URL=http://host.docker.internal:8001

# --- Camera stack (native, NOT in Docker) ----------------------------------
# camerapi + the USB button listener run natively on this PC; one-time setup
# is deploy\setup-camera.bat, config is camerapi\.env, and start-zander.bat
# launches them together with the containers.

# --- Live camera preview ---------------------------------------------------
# Shared secret between the dashboard container and the native camerapi: it
# MUST be the same value as PREVIEW_TOKEN in camerapi\.env (the dashboard
# relays the stream and adds it; the browser never sees it). Needed because
# Docker->host traffic does not reliably arrive as localhost. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
PREVIEW_TOKEN=
# How long a new capture shows "pending" before the dashboard gives up (s).
#PREDICTION_PENDING_TIMEOUT_S=60

# --- Predictions (inspector container) -------------------------------------
# Put the exported model AND its card into DATA_DIR\models\ (default
# deploy\data\models\): detector.onnx + detector.json, then
# `docker compose restart inspector`. Without them every capture gets
# "No model loaded" and the rest of the system works as before.
# Leave INSPECTOR_URL commented to use the inspector container; set it EMPTY
# (INSPECTOR_URL=) to turn predictions off.
#INSPECTOR_URL=
#INSPECTOR_TIMEOUT=60
# onnxruntime threads for the inspector (0 = onnxruntime default)
#INSPECTOR_ORT_THREADS=0
#INSPECTOR_LOG_LEVEL=INFO

# --- Label Studio ----------------------------------------------------------
# Paste the LEGACY token here AFTER the first boot (LS UI -> Account & Settings).
# Leave blank on the very first start; then fill it and re-run `docker compose up -d`.
LABELSTUDIO_API_KEY=
LABELSTUDIO_PROJECT_NAME=PCB Defect Inspection
# First-boot admin account (ignored once Label Studio's DB exists):
LABEL_STUDIO_USERNAME=labelling@zander-aachen.de
LABEL_STUDIO_PASSWORD=change-me
# Pin the Label Studio image to the version you validated (run `label-studio
# version` in your ls-venv). Avoid leaving it at "latest" for production.
LS_IMAGE_TAG=latest

# --- Storage ---------------------------------------------------------------
# Host folder that holds unlabeled/ + labeled/ + predictions/ + models/ + the
# dashboard SQLite. Relative paths are resolved next to this compose file (so
# default = deploy/data).
DATA_DIR=./data
#INSPECTOR_REQUIRE_CARD=true   # default true: the inspector refuses a model without its detector.json card
