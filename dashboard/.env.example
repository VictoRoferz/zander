# Dashboard configuration (Mac/Windows). Copy to .env and edit if needed.

HOST=0.0.0.0
PORT=8003
LOG_LEVEL=INFO

# Where the receiver writes mirrored captures.
# Default = ~/zander-data/  (resolves on Mac and Windows via Path.home()).
# Override only if the receiver runs with a different DATA_ROOT.
# DATA_ROOT=

# Public URL of Label Studio (used by the "Open Label Studio" button).
LABELSTUDIO_URL=http://192.168.0.115:8081

# camerapi base URL (used by the dashboard's "Capture" button).
CAMERAPI_URL=http://192.168.0.115:8001

# Session lifetime in hours (default 8).
SESSION_HOURS=8
