# Dashboard configuration (Mac/Windows). Copy to .env and edit if needed.

HOST=0.0.0.0
PORT=8003
LOG_LEVEL=INFO

# Where the receiver writes captures on this laptop.
# Default = ~/zander-data/  (resolves on Mac and Windows via Path.home()).
# Override only if the receiver runs with a different DATA_ROOT.
# DATA_ROOT=

# Label Studio (now on the laptop). LABELSTUDIO_URL is the API endpoint used to
# live-query the labeled view, so the API key is required.
LABELSTUDIO_URL=http://localhost:8081
# Browser-facing URL for the "Open Label Studio" button. Only differs from
# LABELSTUDIO_URL under Docker (API uses the internal service name). Leave unset
# for the native setup — it defaults to LABELSTUDIO_URL.
# LABELSTUDIO_PUBLIC_URL=http://localhost:8081
LABELSTUDIO_API_KEY=   # REQUIRED - paste token from LS UI -> Account & Settings
LABELSTUDIO_PROJECT_NAME=PCB Defect Inspection
# Optional: pin the project id to skip name resolution.
# LABELSTUDIO_PROJECT_ID=

# camerapi base URL — the native capture service on this machine (used by the
# dashboard's "Capture" button and the live camera panel). Under Docker the
# compose file overrides this to http://host.docker.internal:8001.
CAMERAPI_URL=http://localhost:8001

# Live camera panel: the dashboard relays camerapi's preview stream to
# logged-in browsers and sends this token to camerapi (the browser never sees
# it). It MUST equal PREVIEW_TOKEN in camerapi\.env and, for Docker, in
# deploy\.env. Leave empty only when the dashboard runs natively on the same
# machine as camerapi (camerapi then allows localhost requests without a token).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PREVIEW_TOKEN=

# "Latest result" panel: a new capture shows "Classifying…" until its
# prediction file (DATA_ROOT/predictions/<id>.pred.json, written by the
# receiver) appears, or until this many seconds have passed ("no prediction").
PREDICTION_PENDING_TIMEOUT_S=60
# Where the receiver writes prediction files. Read-only for the dashboard.
# PREDICTIONS_DIR=   (default: DATA_ROOT/predictions)

# Session lifetime in hours (default 8).
SESSION_HOURS=8
