# Dashboard configuration (Mac/Windows). Copy to .env and edit if needed.

HOST=0.0.0.0
PORT=8003
LOG_LEVEL=INFO

# Where the receiver writes captures on this laptop.
# Default = ~/zander-data/  (resolves on Mac and Windows via Path.home()).
# Override only if the receiver runs with a different DATA_ROOT.
# DATA_ROOT=

# Label Studio (now on the laptop). Used for the "Open Label Studio" button
# AND for live-querying the labeled view, so the API key is required.
LABELSTUDIO_URL=http://localhost:8081
LABELSTUDIO_API_KEY=   # REQUIRED - paste token from LS UI -> Account & Settings
LABELSTUDIO_PROJECT_NAME=PCB Defect Inspection
# Optional: pin the project id to skip name resolution.
# LABELSTUDIO_PROJECT_ID=

# camerapi base URL on the Pi (used by the dashboard's "Capture" button).
CAMERAPI_URL=http://192.168.0.115:8001

# Session lifetime in hours (default 8).
SESSION_HOURS=8
