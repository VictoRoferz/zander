# camerapi configuration (native on the hub PC: Windows prod / macOS dev)
# Copy to .env and adjust if needed — the defaults suit the single-PC setup
# where the receiver + dashboard run in Docker on this same machine.
#
# camerapi is a thin capture node: it captures from the direct-attached
# Basler GigE camera, writes to a local spool, and the background uploader
# ships each capture to the receiver. It never talks to Label Studio.

LOG_LEVEL=INFO

# --- Camera ---
# Set USE_CAMERA=false on dev machines without a camera (sample.jpg fallback).
USE_CAMERA=true
CAMERA_INDEX=0
FALLBACK_IMAGE_PATH=sample.jpg
# auto = ethernet on Windows/macOS; on Linux it detects via the route to the
# camera's IP. Set explicitly on the production PC for clarity ("wifi" only
# for throttled debugging).
CAMERA_TRANSPORT=ethernet

# --- Local spool ---
# Captures land in {DATA_ROOT}/spool until the receiver ACKs them. This is
# TRANSIENT storage only — the canonical image store is the receiver's data
# folder (deploy\data under Docker). Files move by HTTP, never a shared
# path, so keep this separate from the Docker DATA_DIR.
# Default: ~/zander-data (%USERPROFILE%\zander-data on Windows).
#DATA_ROOT=

# --- Ingestion hub (receiver) ---
# The receiver container, port-mapped on localhost. Each capture is POSTed
# to {INGEST_URL}/api/v1/ingest with retry until it is accepted, so captures
# survive the Docker side being down or still booting.
INGEST_URL=http://localhost:8002
UPLOAD_TIMEOUT=30
UPLOAD_POLL_INTERVAL=2.0
UPLOAD_MAX_BACKOFF=60.0

# --- USB button listener (scripts/usb_button_listener.py) ---
# Which key fires a capture / the secondary action. Best: reprogram the keypad
# to F13/F14 (no normal keyboard has them). Combos like "ctrl+c" are supported
# for keypads left on their factory copy/paste mapping — but then every REAL
# copy anywhere on this PC also takes a photo. Empty BUTTON_SECONDARY_KEY
# disables the second binding.
#BUTTON_CAPTURE_KEY=f13
#BUTTON_SECONDARY_KEY=f14
#BUTTON_SECONDARY_ACTION=test-camera
#BUTTON_MODE=keyboard
#BUTTON_COOLDOWN=2.0

# --- Dashboard (used to attribute USB-button captures to a user) ---
# camerapi calls GET {DASHBOARD_URL}/api/current-user when no
# X-Triggered-By header is present. Failure → triggered_by=null.
DASHBOARD_URL=http://localhost:8003
DASHBOARD_TIMEOUT=1.5

# --- Live preview (dashboard live view) ---
# Off by default: every capture is then a one-shot GrabOne, exactly as before.
# On: one camera-owner thread holds the camera, streams a small MJPEG preview
# while someone watches, and serves each capture by stopping the stream and
# grabbing a fresh full-resolution frame (the first frame after the trigger).
# Turn it on only after testing on site; at 5 fps the camera sends roughly
# 200 Mbit/s while the preview runs.
LIVE_PREVIEW_ENABLED=false
# Shared secret the dashboard sends as X-Preview-Token. It MUST equal
# PREVIEW_TOKEN in deploy\.env (the Docker dashboard cannot reach the preview
# without it). Empty = only loopback requests to localhost are answered
# (fine for macOS dev with the native dashboard). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
PREVIEW_TOKEN=
PREVIEW_FPS=5
# Preview frames are downscaled to this width; captures stay full resolution.
PREVIEW_MAX_WIDTH=1280
PREVIEW_JPEG_QUALITY=70
# The stream keeps running this long after the last viewer leaves.
PREVIEW_IDLE_STOP_S=10
PREVIEW_MAX_CLIENTS=8
# Reconnect backoff doubles from 1 s up to this cap after the camera is lost.
CAMERA_RECONNECT_MAX_BACKOFF_S=30
# Live mode: per-GrabOne timeout (3 attempts), and how long a capture waits
# for the camera before falling back to sample.jpg. Keep
# LIVE_CAPTURE_TIMEOUT_S above 3 x LIVE_GRAB_TIMEOUT_MS. (With
# CAMERA_TRANSPORT=wifi a frame takes ~8 s: a capture then makes one 30 s
# GrabOne and waits at least 35 s, whatever these say.)
LIVE_GRAB_TIMEOUT_MS=5000
LIVE_CAPTURE_TIMEOUT_S=20
