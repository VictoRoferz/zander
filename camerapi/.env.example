# camerapi configuration (Raspberry Pi 3)
# Copy to .env on the Pi and fill in values.
#
# camerapi is now a thin capture node: it captures, writes to a local spool,
# and the background uploader ships each capture to the laptop ingestion hub
# (receiver). It no longer talks to Label Studio at all.

LOG_LEVEL=INFO

# --- Camera ---
USE_CAMERA=true
CAMERA_INDEX=0
FALLBACK_IMAGE_PATH=sample.jpg
# auto = detect Ethernet vs WiFi by the route to the camera's IP.
# Set to "ethernet" or "wifi" to force a profile.
CAMERA_TRANSPORT=auto

# --- Local spool on the Pi ---
# Captures land in {DATA_ROOT}/spool until the laptop ACKs them.
DATA_ROOT=/home/pi/zander-data

# --- Laptop ingestion hub (receiver) ---
# Single upload target. Each capture is POSTed to {INGEST_URL}/api/v1/ingest
# with retry until the laptop accepts it.
INGEST_URL=http://192.168.0.199:8002
UPLOAD_TIMEOUT=30
UPLOAD_POLL_INTERVAL=2.0
UPLOAD_MAX_BACKOFF=60.0

# --- Dashboard (used to attribute GPIO-button captures to a user) ---
# camerapi calls GET {DASHBOARD_URL}/api/current-user when no
# X-Triggered-By header is present. Failure → triggered_by=null.
DASHBOARD_URL=http://192.168.0.199:8003
DASHBOARD_TIMEOUT=1.5
