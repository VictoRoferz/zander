# camerapi configuration (native on the hub PC: Windows prod / macOS dev)
# Copy to .env and adjust if needed — the defaults suit the single-PC setup
# where the receiver + dashboard run in Docker on this same machine.
#
# camerapi is a thin capture node: it captures from the direct-attached
# Basler GigE camera, writes to a local spool, and the background uploader
# ships each capture to the receiver. It never talks to Label Studio.

LOG_LEVEL=INFO

# --- Camera ---
# Set USE_CAMERA=false on dev machines without a camera (sample.jpg fallback).
USE_CAMERA=true
CAMERA_INDEX=0
FALLBACK_IMAGE_PATH=sample.jpg
# auto = ethernet on Windows/macOS; on Linux it detects via the route to the
# camera's IP. Set explicitly on the production PC for clarity ("wifi" only
# for throttled debugging).
CAMERA_TRANSPORT=ethernet

# --- Local spool ---
# Captures land in {DATA_ROOT}/spool until the receiver ACKs them. This is
# TRANSIENT storage only — the canonical image store is the receiver's data
# folder (deploy\data under Docker). Files move by HTTP, never a shared
# path, so keep this separate from the Docker DATA_DIR.
# Default: ~/zander-data (%USERPROFILE%\zander-data on Windows).
#DATA_ROOT=

# --- Ingestion hub (receiver) ---
# The receiver container, port-mapped on localhost. Each capture is POSTed
# to {INGEST_URL}/api/v1/ingest with retry until it is accepted, so captures
# survive the Docker side being down or still booting.
INGEST_URL=http://localhost:8002
UPLOAD_TIMEOUT=30
UPLOAD_POLL_INTERVAL=2.0
UPLOAD_MAX_BACKOFF=60.0

# --- Dashboard (used to attribute USB-button captures to a user) ---
# camerapi calls GET {DASHBOARD_URL}/api/current-user when no
# X-Triggered-By header is present. Failure → triggered_by=null.
DASHBOARD_URL=http://localhost:8003
DASHBOARD_TIMEOUT=1.5
