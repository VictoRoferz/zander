# zander-inspector configuration (copy to .env). Every line is optional.

# --- Model + card ------------------------------------------------------------
# `cd ml && python cli.py export ...` writes TWO files that belong together:
#   detector.onnx   the model
#   detector.json   its card (adapter, class names, threshold t*, sha256)
# The card is AUTHORITATIVE. Copy both into the same folder; a sha256 mismatch,
# an invalid card or a class-count mismatch makes the inspector refuse the
# model (it stays up, /inspect answers 503, /api/v1/status shows load_error).
# A new model is picked up on restart.
# Dev default: ../ml_data/exports/detector.onnx
# Docker/prod: /data/models/detector.onnx (deploy\data\models\ on the host)
#MODEL_PATH=/data/models/detector.onnx

# true = refuse a model that has no detector.json next to it.
#REQUIRE_CARD=false

# --- Legacy fallback (ONLY without a card; ignored with a WARNING otherwise) ---
# Adapter matching the training framework: ultralytics | deim
#ADAPTER=ultralytics
# Operating threshold t* (from `cli.py choose-op`, chosen on the dev folds).
# NEVER tune this on the test split.
#CONFIDENCE_THRESHOLD=0.25
# Class order of the model output, as a JSON list:
#CLASS_NAMES=["Nicht ausreichend Lot", "Brücke", "Fahne"]

# --- Runtime -----------------------------------------------------------------
# onnxruntime intra-op threads (0 = onnxruntime default)
#ORT_THREADS=0

# Photo store for capture_id lookups (must equal the receiver's DATA_ROOT)
#DATA_ROOT=~/zander-data

# Loopback by default; 0.0.0.0 exposes the (unauthenticated) API on the LAN.
#HOST=127.0.0.1
PORT=8004
LOG_LEVEL=INFO
