# zander-inspector configuration (copy to .env)

# Winning model export (dev default: ../ml_data/exports/nal_detector.onnx;
# Docker/prod: /data/models/nal_detector.onnx on the shared DATA_ROOT)
#MODEL_PATH=/data/models/nal_detector.onnx

# Adapter matching the winning framework: ultralytics | deim
ADAPTER=ultralytics

# Operating threshold t* — take it from ml/reports/results.csv (chosen on dev
# folds at FPPI<=0.5). NEVER tune this on the test split.
CONFIDENCE_THRESHOLD=0.25

# Photo store for capture_id lookups (matches receiver's DATA_ROOT)
#DATA_ROOT=~/zander-data

PORT=8004
LOG_LEVEL=INFO
