# receiver configuration (laptop ingestion hub). Copy to .env and adjust.

HOST=0.0.0.0
PORT=8002
LOG_LEVEL=INFO

# Where images live on the laptop. MUST equal Label Studio's
# LABEL_STUDIO_LOCAL_FILES_DOCUMENT_ROOT. Default ~/zander-data resolves on
# both Windows and macOS.
DATA_ROOT=~/zander-data

# --- Label Studio (running on the same laptop) ---
LABELSTUDIO_URL=http://localhost:8081
LABELSTUDIO_API_KEY=   # REQUIRED - paste token from LS UI -> Account & Settings
LABELSTUDIO_PROJECT_NAME=PCB Defect Inspection
LABELSTUDIO_TIMEOUT=30

# --- Predictions (inspector, optional) ---
# Every ingested capture is sent to the inspector and the result is written to
# DATA_ROOT/predictions/<id>.pred.json. Unset/empty = predictions off.
# Native: scripts/launch.py sets http://localhost:8004 by itself when it starts
# the inspector (only if INSPECTOR_URL is not set here or in the environment,
# so keep this line commented unless you want to override it; an explicit
# empty "INSPECTOR_URL=" turns predictions off). Docker: set by compose.
#INSPECTOR_URL=http://localhost:8004
#INSPECTOR_TIMEOUT=60
#INSPECTOR_STATUS_TIMEOUT=5
#PREDICTION_QUEUE_MAX=1000
